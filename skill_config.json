{
  "input": {
    "bookmark_file": "data/bookmarks.html",
    "rules_file": "data/category_rules.json"
  },
  "pipeline": {
    "copied_bookmark_file": "data/bookmarks.html",
    "parsed_file": "data/parsed_bookmarks.json",
    "classified_file": "data/classified_bookmarks.json",
    "clustering_file": "data/clustering_result.json"
  },
  "output": {
    "html_file": "output/organized_bookmarks.html",
    "reports_directory": "output/reports",
    "duplicate_report_file": "output/reports/duplicates.json",
    "broken_links_report_file": "output/reports/broken_links.json",
    "confirmation_report_file": "output/reports/needs_confirmation.json",
    "review_report_file": "output/reports/review_queue.json"
  },
  "fetch_options": {
    "concurrent_limit": 15,
    "timeout": 15,
    "delay": 0.8,
    "batch_size": 50,
    "max_retries": 2,
    "force_refetch": false,
    "cache_file": "data/bookmarks_with_info.json",
    "check_broken_links": true,
    "user_agent": "BookmarksOrganizer/1.1 (+https://example.com)",
    "proxy": {
      "enabled": false,
      "trust_env": false,
      "http_proxy": null,
      "https_proxy": null,
      "all_proxy": null
    }
  },
  "classification_options": {
    "min_score": 15,
    "confirm_threshold": 25,
    "domain_weight": 30,
    "keyword_weight": 40,
    "title_weight": 20,
    "folder_weight": 25,
    "content_weight": 5
  },
  "clustering_options": {
    "min_cluster_size": 10,
    "max_keywords": 3,
    "max_bookmarks_without_clustering": 20
  },
  "logging": {
    "level": "INFO",
    "file": "logs/bookmarks_organizer.log",
    "console": true
  }
}
